      "email": "dev-admin@prospector.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Dev",
      "credentials": [{ "type": "password", "value": "devpassword123", "temporary": false }]
    },
    {
