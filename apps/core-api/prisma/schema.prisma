// Modelo inicial (Fase 0 / V001): apenas o módulo Identity & Access.
// Convenções: docs/DOCUMENTATION.md seção 3.1.
// IDs são UUIDv7 gerados pela aplicação (lib `uuidv7`), nunca por default do banco —
// por isso os campos `id` não usam @default(uuid()) do Prisma (que gera UUIDv4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  memberships Membership[]

  @@map("organizations")
}

model User {
  id          String   @id @db.Uuid
  oidcSubject String   @unique @map("oidc_subject")
  email       String
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  memberships             Membership[]
  assignedLeads           Lead[]
  approvedProposals       Proposal[]
  approvedOutreachMessages OutreachMessage[]

  @@map("users")
}

model Membership {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  role           String
  status         String @default("ACTIVE")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId, role, status])
  @@map("memberships")
}

// --- Campaigns (Fase 1) --------------------------------------------------

model Campaign {
  id                String   @id @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  name              String
  category          String
  geographicFilter  Json     @map("geographic_filter")
  discoveryFilters  Json     @map("discovery_filters")
  providers         String[]
  status            String   @default("DRAFT")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  runs CampaignRun[]

  @@index([organizationId, status, updatedAt(sort: Desc)])
  @@map("campaigns")
}

model CampaignRun {
  id              String    @id @db.Uuid
  campaignId      String    @map("campaign_id") @db.Uuid
  status          String    @default("QUEUED")
  filtersSnapshot Json      @map("filters_snapshot")
  discoveredCount Int       @default(0) @map("discovered_count")
  acceptedCount   Int       @default(0) @map("accepted_count")
  duplicateCount  Int       @default(0) @map("duplicate_count")
  failedCount     Int       @default(0) @map("failed_count")
  requestedBy     String?   @map("requested_by") @db.Uuid
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz
  failureReason   String?   @map("failure_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  campaign Campaign     @relation(fields: [campaignId], references: [id])
  sources  LeadSource[]

  @@index([campaignId, createdAt(sort: Desc)])
  @@map("campaign_runs")
}

// --- Discovery & Leads (Fase 1) -------------------------------------------

model LeadSource {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  campaignRunId  String?  @map("campaign_run_id") @db.Uuid
  provider       String
  externalId     String   @map("external_id")
  rawPayload     Json     @map("raw_payload")
  collectedAt    DateTime @default(now()) @map("collected_at") @db.Timestamptz
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  lead        Lead         @relation(fields: [leadId], references: [id])
  campaignRun CampaignRun? @relation(fields: [campaignRunId], references: [id])

  @@unique([organizationId, provider, externalId])
  @@index([leadId])
  @@map("lead_sources")
}

model Lead {
  id                 String    @id @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  legalName          String    @map("legal_name")
  tradeName          String?   @map("trade_name")
  category           String
  categoriesRaw      String[]  @map("categories_raw")
  addressLine        String?   @map("address_line")
  city               String
  cityNormalized     String    @map("city_normalized")
  state              String?
  country            String?
  latitude           Float?
  longitude          Float?
  domain             String?
  normalizedDomain   String?   @map("normalized_domain")
  websiteUrl         String?   @map("website_url")
  websiteStatus      String    @default("UNKNOWN") @map("website_status")
  rating             Float?
  reviewCount        Int?      @map("review_count")
  crmStage           String    @default("NEW") @map("crm_stage")
  currentScore       Int?      @map("current_score")
  assignedUserId     String?   @map("assigned_user_id") @db.Uuid
  nextActionAt       DateTime? @map("next_action_at") @db.Timestamptz
  dataQualityStatus  String    @default("NEW") @map("data_quality_status")
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz
  mergedIntoId       String?   @map("merged_into_id") @db.Uuid
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  assignedUser User?        @relation(fields: [assignedUserId], references: [id])
  mergedInto   Lead?        @relation("LeadMerge", fields: [mergedIntoId], references: [id])
  mergedLeads  Lead[]       @relation("LeadMerge")
  sources      LeadSource[]
  contacts     LeadContact[]
  snapshots    WebsiteSnapshot[]
  scores       LeadScore[]
  aiAnalyses   AiAnalysis[]
  proposals    Proposal[]
  activities   CrmActivity[]
  outreachMessages OutreachMessage[]

  @@index([organizationId, crmStage, currentScore(sort: Desc), updatedAt(sort: Desc)])
  @@index([organizationId, cityNormalized, category])
  @@map("leads")
}

model LeadContact {
  id                 String    @id @db.Uuid
  leadId             String    @map("lead_id") @db.Uuid
  type               String
  value              String
  normalizedValue    String    @map("normalized_value")
  primaryContact     Boolean   @default(false) @map("primary_contact")
  verificationStatus String    @default("UNVERIFIED") @map("verification_status")
  sourceId           String?   @map("source_id") @db.Uuid
  confidence         Float?
  lastVerifiedAt     DateTime? @map("last_verified_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("lead_contacts")
}

// --- Auditing (Fase 2) ------------------------------------------------------

model WebsiteSnapshot {
  id           String   @id @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  requestedUrl String   @map("requested_url")
  finalUrl     String?  @map("final_url")
  httpStatus   Int?     @map("http_status")
  contentHash  String?  @map("content_hash")
  capturedAt   DateTime @default(now()) @map("captured_at") @db.Timestamptz

  lead   Lead          @relation(fields: [leadId], references: [id])
  audits WebsiteAudit[]

  @@index([leadId, capturedAt(sort: Desc)])
  @@map("website_snapshots")
}

model WebsiteAudit {
  id                 String   @id @db.Uuid
  websiteSnapshotId  String   @map("website_snapshot_id") @db.Uuid
  status             String   @default("QUEUED")
  engineVersion      String?  @map("engine_version")
  performanceScore   Int?     @map("performance_score")
  accessibilityScore Int?     @map("accessibility_score")
  seoScore           Int?     @map("seo_score")
  bestPracticesScore Int?     @map("best_practices_score")
  technicalMetrics   Json?    @map("technical_metrics")
  featuresDetected   Json?    @map("features_detected")
  reportObjectKey    String?  @map("report_object_key")
  screenshotObjectKey String? @map("screenshot_object_key")
  failureReason      String?  @map("failure_reason")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  snapshot WebsiteSnapshot @relation(fields: [websiteSnapshotId], references: [id])
  findings AuditFinding[]

  @@index([websiteSnapshotId, createdAt(sort: Desc)])
  @@map("website_audits")
}

model AuditFinding {
  id             String @id @db.Uuid
  websiteAuditId String @map("website_audit_id") @db.Uuid
  code           String
  severity       String
  category       String
  evidence       Json

  audit WebsiteAudit @relation(fields: [websiteAuditId], references: [id])

  @@index([websiteAuditId, severity, category])
  @@index([code])
  @@map("audit_findings")
}

// --- Scoring (Fase 3) --------------------------------------------------------

model ScorePolicy {
  id            String    @id @db.Uuid
  version       String    @unique
  description   String
  factorsConfig Json      @map("factors_config")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz
  status        String    @default("ACTIVE")

  @@map("score_policies")
}

model LeadScore {
  id            String   @id @db.Uuid
  leadId        String   @map("lead_id") @db.Uuid
  // Referencia score_policies.version por rótulo semântico, não por FK física
  // (docs/DOCUMENTATION.md seção 3.3) — uma política vigente nunca é editada.
  policyVersion String   @map("policy_version")
  rawScore      Int      @map("raw_score")
  totalScore    Int      @map("total_score")
  band          String
  calculatedAt  DateTime @default(now()) @map("calculated_at") @db.Timestamptz

  lead    Lead          @relation(fields: [leadId], references: [id])
  factors ScoreFactor[]

  @@index([leadId, calculatedAt(sort: Desc)])
  @@map("lead_scores")
}

model ScoreFactor {
  id          String @id @db.Uuid
  leadScoreId String @map("lead_score_id") @db.Uuid
  factorCode  String @map("factor_code")
  points      Int
  evidence    Json

  leadScore LeadScore @relation(fields: [leadScoreId], references: [id])

  @@index([leadScoreId])
  @@map("score_factors")
}

// --- Intelligence (Fase 4) ---------------------------------------------------

model PromptTemplate {
  id        String   @id @db.Uuid
  kind      String
  version   String   @unique
  content   String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("prompt_templates")
}

model AiAnalysis {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  leadId           String    @map("lead_id") @db.Uuid
  kind             String
  status           String    @default("QUEUED")
  modelName        String?   @map("model_name")
  // Referencia prompt_templates.version por rótulo, não por FK física — mesma
  // convenção de score_policies (docs/DOCUMENTATION.md seção 3.3).
  promptVersion    String?   @map("prompt_version")
  inputSnapshot    Json      @map("input_snapshot")
  output           Json?
  reviewStatus     String    @default("PENDING_REVIEW") @map("review_status")
  tokensUsed       Int?      @map("tokens_used")
  latencyMs        Int?      @map("latency_ms")
  estimatedCostUsd Float?    @map("estimated_cost_usd")
  failureReason    String?   @map("failure_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, createdAt(sort: Desc)])
  @@map("ai_analyses")
}

model Proposal {
  id         String    @id @db.Uuid
  leadId     String    @map("lead_id") @db.Uuid
  revision   Int       @default(1)
  status     String    @default("DRAFT")
  content    String
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  lead     Lead  @relation(fields: [leadId], references: [id])
  approver User? @relation(fields: [approvedBy], references: [id])

  @@index([leadId, revision(sort: Desc)])
  @@map("proposals")
}

// --- Outreach (Fase 6) -----------------------------------------------------

model OutreachMessage {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  leadId          String    @map("lead_id") @db.Uuid
  channel         String
  status          String    @default("PENDING_APPROVAL")
  content         String
  // Valor normalizado do destinatário no momento da criação — precisa
  // sobreviver mesmo que o contato do lead mude depois, para a checagem de
  // supressão em request-send refletir o que foi de fato aprovado.
  recipientValue  String    @map("recipient_value")
  approvedBy      String?   @map("approved_by") @db.Uuid
  rejectedReason  String?   @map("rejected_reason")
  failureReason   String?   @map("failure_reason")
  sentAt          DateTime? @map("sent_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  lead     Lead  @relation(fields: [leadId], references: [id])
  approver User? @relation(fields: [approvedBy], references: [id])

  @@index([leadId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("outreach_messages")
}

model ContactSuppression {
  id                   String   @id @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  channel              String
  // Hash do valor normalizado, nunca o valor em claro (docs/DOCUMENTATION.md
  // seção 5.7 e 3.3) — suficiente para bloquear reimportação/novo contato sem
  // reter o dado pessoal em si.
  normalizedValueHash  String   @map("normalized_value_hash")
  reason               String
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, channel, normalizedValueHash])
  @@map("contact_suppressions")
}

// --- CRM (Fase 5) --------------------------------------------------------

model CrmActivity {
  id           String    @id @db.Uuid
  leadId       String    @map("lead_id") @db.Uuid
  activityType String    @map("activity_type")
  summary      String
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  nextActionAt DateTime? @map("next_action_at") @db.Timestamptz

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, occurredAt(sort: Desc)])
  @@map("crm_activities")
}

// --- Operations (Job/Outbox/Audit) ----------------------------------------

model AuditLog {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id") @db.Uuid
  changes        Json
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

model Job {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  type           String
  status         String   @default("QUEUED")
  idempotencyKey String?  @map("idempotency_key")
  attemptCount   Int      @default(0) @map("attempt_count")
  payload        Json
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([organizationId, type, idempotencyKey])
  @@map("jobs")
}

model OutboxEvent {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventType      String    @map("event_type")
  eventVersion   Int       @default(1) @map("event_version")
  correlationId  String    @map("correlation_id")
  causationId    String?   @map("causation_id")
  payload        Json
  status         String    @default("PENDING")
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, availableAt])
  @@map("outbox_events")
}
