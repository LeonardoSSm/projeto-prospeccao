# Copie para .env.local e ajuste apenas os valores locais. Nunca commitar segredos reais.

# --- Geral ---
NODE_ENV=development

# --- core-api ---
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://prospector:prospector@postgres:5432/prospector
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://prospector:prospector@rabbitmq:5672
OIDC_ISSUER_URI=http://oidc-mock:8081
OIDC_AUDIENCE=prospector-api
S3_ENDPOINT=http://minio:9000
S3_BUCKET=prospector-artifacts
S3_ACCESS_KEY=prospector
S3_SECRET_KEY=prospector123
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
PLACES_PROVIDER=mock
PLACES_API_KEY=
OUTREACH_CHANNEL_PROVIDER=mock
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- audit-worker ---
AUDIT_MAX_CONCURRENCY=2
AUDIT_TIMEOUT_MS=90000
AUDIT_MAX_ATTEMPTS=3
AUDIT_RETRY_DELAY_MS=15000
AUDIT_MAX_REDIRECTS=5
AUDIT_MAX_RESPONSE_BYTES=15728640

# --- web ---
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- infraestrutura (usado pelo compose.yaml) ---
POSTGRES_DB=prospector
POSTGRES_USER=prospector
POSTGRES_PASSWORD=prospector
RABBITMQ_DEFAULT_USER=prospector
RABBITMQ_DEFAULT_PASS=prospector
MINIO_ROOT_USER=prospector
MINIO_ROOT_PASSWORD=prospector123
